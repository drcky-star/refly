# Refly ayarları — bu dosyayı .env olarak kopyalayıp doldur
FLASK_SECRET_KEY=degistir-bunu

# PubMed hız limiti için (opsiyonel ama önerilir — ücretsiz)
# https://www.ncbi.nlm.nih.gov/account/ -> API key
NCBI_EMAIL=dr_cky@icloud.com
NCBI_API_KEY=

# CrossRef nazik havuzu için e-posta (opsiyonel)
CROSSREF_EMAIL=dr_cky@icloud.com

# Kendi EndNote/Zotero CSL stillerini koyduğun masaüstü klasörü (opsiyonel)
# Örn: /Users/kaan/Desktop/refly-stiller
REFLY_CSL_DIR=

# --- Çok kullanıcılı + kota (dışarı satış) ---
# Açıkken giriş zorunlu, veriler + kotalar kullanıcıya göre
REFLY_AUTH=0
REFLY_DEFAULT_PLAN=free
# GÜVENLİK — üretimde MUTLAKA güçlü rastgele anahtar:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# HTTPS arkasında güvenli çerez + güvenlik başlıkları (auth açıksa otomatik açık)
REFLY_PRODUCTION=1
# Yedek/geri-yükleme gibi TÜM-sistem işlemlerine izinli admin e-postaları (virgülle)
REFLY_ADMIN_EMAILS=dr_cky@icloud.com
# Açık kayıt (davetiyeli yapmak istersen 0)
REFLY_OPEN_REGISTRATION=1
# Kullanıcı planını değiştirmek için gizli anahtar (POST /api/admin/plan)
REFLY_ADMIN_KEY=
# Ödeme sağlayıcı webhook'u için gizli anahtar (POST /api/billing/webhook)
REFLY_BILLING_SECRET=
# Plan limitlerini ez (aylık autocite/autotag, refs = kütüphane boyutu; null = sınırsız)
# REFLY_PLANS={"free":{"autocite":10,"autotag":10,"refs":200},"pro":{"autocite":300,"autotag":300,"refs":20000}}

# --- E-posta doğrulama + gönderim (SMTP) ---
# SMTP ayarlıysa ve bu 1 ise, yeni kayıtlar e-postasını doğrulayana kadar otomatik
# referanslama yapamaz (sahte hesap istismarını önler). SMTP yoksa otomatik kapalı.
REFLY_REQUIRE_EMAIL_VERIFICATION=1
REFLY_SMTP_HOST=            # örn: smtp.gmail.com / smtp.sendgrid.net / email-smtp.eu-west-1.amazonaws.com
REFLY_SMTP_PORT=587        # 465 = SSL, 587 = STARTTLS
REFLY_SMTP_USER=
REFLY_SMTP_PASS=
REFLY_SMTP_FROM=dr_cky@icloud.com   # gönderen adres
REFLY_SMTP_FROM_NAME=Refly
# Doğrulama linkleri için herkese açık adres (Render/alan adın). Boşsa istekten türetilir.
REFLY_PUBLIC_URL=          # örn: https://refly.onrender.com
# Yasal/destek sayfalarında görünen iletişim adresi
REFLY_CONTACT_EMAIL=dr_cky@icloud.com

# --- Off-site yedek (S3 uyumlu: AWS S3 / DigitalOcean Spaces / Backblaze B2 / Cloudflare R2) ---
# Ayarlıysa her otomatik/elle yedek buluta da yüklenir (sunucu/disk ölse bile veri kalır).
REFLY_BACKUP_S3_BUCKET=
REFLY_BACKUP_S3_ENDPOINT=  # Spaces/B2/R2 için endpoint URL; AWS S3'te boş bırak
REFLY_BACKUP_S3_REGION=    # örn: eu-central-1 (gerekirse)
REFLY_BACKUP_S3_ACCESS_KEY=
REFLY_BACKUP_S3_SECRET_KEY=
REFLY_BACKUP_S3_PREFIX=refly-backups

# --- Hata izleme (Sentry) — DSN verilirse otomatik açılır (ücretsiz plan yeterli) ---
SENTRY_DSN=

